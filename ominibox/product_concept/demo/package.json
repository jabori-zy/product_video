{
  "name": "omnibox-product-demo",
  "version": "0.1.0",
  "private": true,
  "description": "小黑 OmniBox 产品介绍片 · 草稿 demo（45 s，无配乐，占位矩形）",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Demo out/demo.mp4",
    "render:paced": "node tools/render-paced.mjs",
    "render:content": "node tools/render-content.mjs",
    "render:app": "remotion render DemoApp out/demo-add_more_app.mp4",
    "render:slogan": "remotion render DemoSlogan out/demo_modify_slogon.mp4",
    "audio": "esbuild audio/build.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=audio/.build/build.cjs && node audio/.build/build.cjs",
    "still": "remotion still Demo"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
